Options -MultiViews
RewriteEngine On
RewriteBase /

# Si el archivo o directorio existe fisicamente, servir directo
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demas -> index.html (React Router se encarga del routing)
RewriteRule ^ index.html [L]
